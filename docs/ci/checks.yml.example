name: Research software checks
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  verified-runtime:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
          cache: pip
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: python -m pip install -r requirements-dev.txt
      - run: python scripts/setup_runtime.py
        env:
          GITHUB_TOKEN: ${{ github.token }}
      - run: python -m submission check
      - run: python -m submission audit
      - run: git diff --check
      # Manual only: pushing does not start a potentially billable runner.
      # Raw-MODIS test skips when excluded raw source downloads are absent.
